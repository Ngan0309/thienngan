<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI LÀ TRIỆU PHÚ - V14 (Có Quyền Trợ Giúp)</title>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #071a3d, #0b2d62, #1c5abf);
      color: white;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .app {
      width: min(1000px, 95vw);
      min-height: 700px;
      background: rgba(5, 13, 35, 0.85);
      border: 2px solid rgba(255,255,255,0.12);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 0 35px rgba(0,0,0,0.45);
      position: relative;
      overflow: hidden;
    }

    .screen { display: none; position: relative; z-index: 2; }
    .screen.active { display: block; animation: fadeIn 0.25s ease; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .title {
      text-align: center;
      font-size: clamp(2.5rem, 5vw, 4.8rem);
      font-weight: 900;
      color: #ffd54a;
      letter-spacing: 2px;
      text-shadow: 0 0 18px rgba(255,213,74,0.6);
      margin-bottom: 18px;
    }

    .subtitle {
      text-align: center;
      color: #dfe8ff;
      font-size: 1.15rem;
      line-height: 1.5;
      margin-bottom: 30px;
    }

    .main-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 16px 24px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.2s;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      font-family: inherit;
    }

    button:hover:not(:disabled) { transform: translateY(-2px); }
    button:active:not(:disabled) { transform: translateY(0); }
    button:disabled { opacity: 0.4; cursor: not-allowed; filter: grayscale(1); }

    .primary { background: linear-gradient(135deg, #ffb300, #ff8f00); color: #111; min-width: 180px; }
    .secondary { background: #dfe8ff; color: #14315f; min-width: 160px; }
    .ghost { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.12); }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(180px, 1fr));
      gap: 16px;
      max-width: 620px;
      margin: 0 auto;
    }

    .difficulty-btn {
      background: linear-gradient(180deg, #214c94, #183b75);
      color: white;
      border: 1px solid rgba(255,255,255,0.15);
      min-height: 80px;
      font-size: 1.05rem;
    }

    .instruction-box {
      max-width: 700px;
      margin: 0 auto;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 20px 22px;
      line-height: 1.8;
      color: #eef4ff;
    }

    .instruction-box ul { margin: 0; padding-left: 18px; }

    .game-layout {
      display: grid;
      grid-template-columns: 1.7fr 0.8fr;
      gap: 22px;
      min-height: 640px;
    }

    .board {
      background: rgba(8, 18, 40, 0.8);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Quyền trợ giúp CSS */
    .lifelines {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-bottom: 12px;
    }

    .lifeline-btn {
      background: linear-gradient(180deg, #1d3f82, #0e244d);
      border: 2px solid #ffd54a;
      color: #ffd54a;
      border-radius: 50px;
      padding: 8px 16px;
      font-size: 0.9rem;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .question-box {
      background: linear-gradient(180deg, #0a1f46, #103769);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 28px 20px;
      min-height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: clamp(1.2rem, 2vw, 1.8rem);
      line-height: 1.5;
      margin-bottom: 16px;
      color: white;
    }

    .answers {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .answer {
      background: linear-gradient(180deg, #1d3f82, #143669);
      color: white;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 12px;
      padding: 18px 14px;
      text-align: left;
      display: flex;
      align-items: center;
      min-height: 85px;
      font-size: 1.05rem;
      cursor: pointer;
    }

    .answer.hidden { visibility: hidden; }

    .answer .label {
      width: 34px;
      height: 34px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      background: rgba(255,255,255,0.11);
      border-radius: 50%;
      margin-right: 12px;
      font-weight: bold;
      color: #ffd54a;
      flex-shrink: 0;
    }

    .answer.correct { background: linear-gradient(180deg, #19a85d, #116f43); }
    .answer.wrong { background: linear-gradient(180deg, #d73a3a, #8b1d1d); }
    .answer.selected { outline: 3px solid #ffc857; }

    .side-panel {
      background: rgba(8, 18, 40, 0.8);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 16px;
    }

    .money-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .money-list li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
    }

    .money-list li.active {
      background: rgba(255,213,74,0.12);
      border: 1px solid rgba(255,213,74,0.6);
      color: #ffe48d;
      font-weight: bold;
    }

    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      color: #dfe8ff;
      font-size: 0.95rem;
    }

    .controls {
      display: flex;
      justify-content: flex-end;
      margin-top: 18px;
      gap: 10px;
    }

    .small-btn { min-width: 160px; }

    .next-panel {
      display: none;
      margin-top: 18px;
      gap: 12px;
      justify-content: center;
    }
    .next-panel.visible { display: flex; }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.62);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 50;
    }
    .modal.active { display: flex; }

    .modal-card {
      width: min(480px, 92vw);
      background: linear-gradient(180deg, #152d5e, #0e2144);
      border-radius: 18px;
      padding: 28px 22px;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.15);
      box-shadow: 0 18px 40px rgba(0,0,0,0.35);
    }

    /* Biểu đồ khán giả */
    .poll-bar-container {
      display: flex;
      justify-content: space-around;
      align-items: flex-end;
      height: 120px;
      margin: 20px 0;
      background: rgba(0,0,0,0.2);
      padding: 10px;
      border-radius: 8px;
    }

    .poll-column {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 20%;
    }

    .poll-bar {
      width: 100%;
      background: #ffb300;
      border-radius: 4px 4px 0 0;
      transition: height 0.5s ease;
    }

    .timer {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      padding: 6px 10px;
      border-radius: 999px;
      font-weight: bold;
      color: #ffd54a;
      min-width: 90px;
      text-align: center;
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 31;
    }

    .timer.warning { color: #ffb36b; border-color: rgba(255,179,107,0.6); }
    .timer.danger  { color: #ff7a7a; border-color: rgba(255,122,122,0.6); }

    @media (max-width: 780px) {
      .game-layout { grid-template-columns: 1fr; }
      .answers { grid-template-columns: 1fr; }
      .menu-grid { grid-template-columns: 1fr; }
      .timer { position: static; display: inline-block; margin: 0 auto 18px; }
    }
  </style>
</head>
<body>
  <div class="app">
    <div id="timer" class="timer">30s</div>

    <!-- HOME SCREEN -->
    <section id="homeScreen" class="screen active">
      <div class="title">AI LÀ TRIỆU PHÚ</div>
