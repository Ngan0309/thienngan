          { q: "Tính nhẩm: 3 + 3 × 3 = ?", a: ["18", "12", "9", "15"], c: 1 },
          { q: "Một con mèo có 4 chân, 2 con mèo có mấy chân?", a: ["4", "6", "8", "10"], c: 2 },
          { q: "Thủ đô của Nhật Bản là:", a: ["Kyoto", "Tokyo", "Osaka", "Nagoya"], c: 1 },
          { q: "Một ngày bình thường có bao nhiêu giờ?", a: ["18", "20", "24", "30"], c: 2 }
        ]
      }
    };

    const state = {
      currentLevelName: "siêu dễ",
      currentLevelIndex: 0,
      rounds: 0,
      earned: 0,
      usedQuestions: [],
      currentQuestion: null,
      answered: false,
      levelFinished: false,
      timeLeft: 30,
      timerId: null,
      lifelines: { fiftyFifty: true, call: true, audience: true }
    };

    const levelInfo = document.getElementById("levelInfo");
    const moneyInfo = document.getElementById("moneyInfo");
    const questionBox = document.getElementById("questionBox");
    const answersEl = document.getElementById("answers");
    const moneyList = document.getElementById("moneyList");
    const nextPanel = document.getElementById("nextPanel");
    const timerEl = document.getElementById("timer");
    const resultModal = document.getElementById("resultModal");
    const resultTitle = document.getElementById("resultTitle");
    const resultContent = document.getElementById("resultContent");

    let audioCtx = null, musicGain = null, musicScheduler = null;

    function getAudioCtx() {
      if (!audioCtx) {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (Ctx) audioCtx = new Ctx();
      }
      if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
      return audioCtx;
    }

    function ensureMusicGain() {
      const ctx = getAudioCtx();
      if (!ctx) return null;
      if (!musicGain) {
        musicGain = ctx.createGain();
        musicGain.gain.value = 0.5;
        musicGain.connect(ctx.destination);
      }
      return musicGain;
    }

    function playEffect(freq, duration, type = "sine", volume = 0.06, delay = 0) {
      const ctx = getAudioCtx();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      gain.gain.value = volume;
      osc.connect(gain);
      gain.connect(ensureMusicGain() || ctx.destination);
      const t = ctx.currentTime + delay;
      osc.start(t);
      gain.gain.setValueAtTime(volume, t);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + duration);
      osc.stop(t + duration);
    }

    function playStartSound() { [392, 523.25, 659.25, 783.99].forEach((f, i) => playEffect(f, 0.18, "triangle", 0.06, i * 0.08)); }
    function playCorrectSound() { [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => playEffect(f, 0.18, "triangle", 0.08, i * 0.1)); }
    function playWrongSound() { [220, 174.61, 146.83].forEach((f, i) => playEffect(f, 0.18, "sawtooth", 0.07, i * 0.12)); }
    function playTapSound() { playEffect(880, 0.05, "square", 0.04); }

    function startMusicLoop() {
      const ctx = getAudioCtx();
      if (!ctx || !musicGain) return;
      if (musicScheduler) clearInterval(musicScheduler);
      const melody = [261.63, 329.63, 392.00, 329.63, 392.00, 523.25, 493.88, 440.00];
      let step = 0;
      musicScheduler = setInterval(() => {
        const note = melody[step % melody.length];
        playEffect(note, 0.22, "triangle", 0.035);
        step++;
      }, 340);
    }

    function stopMusicLoop() {
      if (musicScheduler) { clearInterval(musicScheduler); musicScheduler = null; }
    }

    function showScreen(id) {
      document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
      document.getElementById(id).classList.add("active");
    }

    function formatMoney(value) {
      return new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(value);
    }

    function currentLevelData() { return levels[state.currentLevelName]; }

    function renderMoneyList() {
      const data = currentLevelData();
      const list = [];
      for (let i = 0; i < data.rounds; i++) list.push(data.prizeBase * (i + 1));
      list.reverse();
      
      moneyList.innerHTML = "";
      list.forEach((money, index) => {
        const li = document.createElement("li");
        const levelNumber = list.length - index;
        if (levelNumber === state.rounds) li.classList.add("active");
        li.innerHTML = `<span>Màn ${levelNumber}</span><strong>${formatMoney(money)}</strong>`;
        moneyList.appendChild(li);
      });
    }

    function updateTimerUI() {
      timerEl.textContent = `${state.timeLeft}s`;
      timerEl.classList.remove("warning", "danger");
      if (state.timeLeft <= 10) timerEl.classList.add("danger");
      else if (state.timeLeft <= 20) timerEl.classList.add("warning");
    }

    function clearTimer() {
      if (state.timerId) { clearInterval(state.timerId); state.timerId = null; }
    }

    function startTimer() {
      clearTimer();
      state.timeLeft = 30;
      updateTimerUI();
      state.timerId = setInterval(() => {
        if (state.answered) return;
        state.timeLeft -= 1;
        updateTimerUI();
        if (state.timeLeft <= 0) { clearTimer(); forceTimeout(); }
      }, 1000);
    }

    function forceTimeout() {
      if (state.answered) return;
      state.answered = true;
      const buttons = [...answersEl.children];
      buttons.forEach(btn => btn.disabled = true);
      buttons[state.currentQuestion.c].classList.add("correct");
      playWrongSound();
      setTimeout(() => endGame(false), 900);
    }

    function pickQuestion() {
      const source = currentLevelData().questions;
      const available = source.filter(q => !state.usedQuestions.includes(q.q));
      if (available.length === 0) {
        state.usedQuestions = [];
        return source[Math.floor(Math.random() * source.length)];
      }
      return available[Math.floor(Math.random() * available.length)];
    }

    function updateLifelineUI() {
      document.getElementById("fiftyFiftyBtn").disabled = !state.lifelines.fiftyFifty;
      document.getElementById("callBtn").disabled = !state.lifelines.call;
      document.getElementById("audienceBtn").disabled = !state.lifelines.audience;
    }

    function renderQuestion() {
      state.currentQuestion = pickQuestion();
      state.usedQuestions.push(state.currentQuestion.q);

      state.answered = false;
      state.levelFinished = false;
      nextPanel.classList.remove("visible");

      state.rounds += 1;
      levelInfo.textContent = `Màn ${state.rounds}`;
      moneyInfo.textContent = formatMoney(state.earned);

      questionBox.textContent = state.currentQuestion.q;
      answersEl.innerHTML = "";

      state.currentQuestion.a.forEach((option, index) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "answer";
        btn.innerHTML = `<span class="label">${String.fromCharCode(65 + index)}</span><span>${option}</span>`;
        btn.addEventListener("click", () => chooseAnswer(index));
        answersEl.appendChild(btn);
      });

      renderMoneyList();
      updateLifelineUI();
      startTimer();
      playTapSound();
    }

    function chooseAnswer(index) {
      if (state.answered) return;
      clearTimer();
      state.answered = true;

      const buttons = [...answersEl.children];
      buttons.forEach((btn, i) => {
        btn.disabled = true;
        if (i === index) btn.classList.add("selected");
        if (i === state.currentQuestion.c) btn.classList.add("correct");
        if (i === index && i !== state.currentQuestion.c) btn.classList.add("wrong");
      });

      if (index === state.currentQuestion.c) {
        state.earned = currentLevelData().prizeBase * state.rounds;
        playCorrectSound();
        const totalQuestions = currentLevelData().rounds;

        if (state.rounds >= totalQuestions) {
          state.levelFinished = true;
          setTimeout(() => {
            showModalInfo("CHÚC MỪNG!", `<p>Bạn đã hoàn thành xuất sắc mức ${state.currentLevelName.toUpperCase()}! Số tiền: ${formatMoney(state.earned)}.</p>`, true);
            nextPanel.classList.add("visible");
          }, 700);
          return;
        }

        setTimeout(() => renderQuestion(), 1100);
      } else {
        playWrongSound();
        setTimeout(() => endGame(false), 900);
      }
    }

    function showModalInfo(title, htmlContent, isEnd = false) {
      resultTitle.textContent = title;
      resultContent.innerHTML = htmlContent;
      
      document.getElementById("modalActionBtn").style.display = isEnd ? "none" : "inline-block";
      document.getElementById("restartBtn").style.display = isEnd ? "inline-block" : "none";
      document.getElementById("homeBtnModal").style.display = isEnd ? "inline-block" : "none";

      resultModal.classList.add("active");
    }

    function endGame(won) {
      const msg = won 
        ? `Bạn đã hoàn thành mức ${state.currentLevelName.toUpperCase()} và nhận được ${formatMoney(state.earned)}.`
        : `Bạn đã dừng chân tại câu hỏi này. Số tiền thưởng nhận được: ${formatMoney(state.earned)}.`;
      showModalInfo(won ? "CHÚC MỪNG!" : "HẾT GAME", `<p>${msg}</p>`, true);
    }

    /* KHẢ NĂNG TRỢ GIÚP */
    // 1. 50:50
    document.getElementById("fiftyFiftyBtn").addEventListener("click", () => {
      if (!state.lifelines.fiftyFifty || state.answered) return;
      state.lifelines.fiftyFifty = false;
      updateLifelineUI();

      const correctIndex = state.currentQuestion.c;
      const wrongIndexes = [0, 1, 2, 3].filter(i => i !== correctIndex);
      
      // Chọn ngẫu nhiên 2 đáp án sai để ẩn
      wrongIndexes.sort(() => Math.random() - 0.5);
      const toHide = wrongIndexes.slice(0, 2);

      const buttons = [...answersEl.children];
      toHide.forEach(idx => buttons[idx].classList.add("hidden"));
      playTapSound();
    });

    // 2. Gọi điện thoại
    document.getElementById("callBtn").addEventListener("click", () => {
      if (!state.lifelines.call || state.answered) return;
      state.lifelines.call = false;
      updateLifelineUI();

      const correctIndex = state.currentQuestion.c;
      const labels = ["A", "B", "C", "D"];
      // 80% chọn đúng
      const isSmart = Math.random() < 0.8;
      const adviceIndex = isSmart ? correctIndex : Math.floor(Math.random() * 4);

      showModalInfo("📞 CỘNG SỰ TƯ VẤN", `<p>"Theo tôi, câu trả lời đúng cho câu hỏi này là đáp án <strong>${labels[adviceIndex]}</strong>!"</p>`);
      playTapSound();
    });

    // 3. Hỏi ý kiến khán giả
    document.getElementById("audienceBtn").addEventListener("click", () => {
      if (!state.lifelines.audience || state.answered) return;
      state.lifelines.audience = false;
      updateLifelineUI();

      const correctIndex = state.currentQuestion.c;
      let percentages = [0, 0, 0, 0];
      
      // Tỷ lệ cho câu đúng (40 - 70%)
      const correctPercent = Math.floor(Math.random() * 30) + 40;
      percentages[correctIndex] = correctPercent;

      let remaining = 100 - correctPercent;
      const otherIndexes = [0, 1, 2, 3].filter(i => i !== correctIndex);

      otherIndexes.forEach((idx, i) => {
        if (i === otherIndexes.length - 1) {
          percentages[idx] = remaining;
        } else {
          const val = Math.floor(Math.random() * remaining);
          percentages[idx] = val;
          remaining -= val;
        }
      });

      const labels = ["A", "B", "C", "D"];
      let pollHTML = `<p>Khán giả trong trường quay đã bình chọn:</p><div class="poll-bar-container">`;
      percentages.forEach((pct, i) => {
        pollHTML += `
          <div class="poll-column">
            <small>${pct}%</small>
            <div class="poll-bar" style="height: ${pct}%;"></div>
            <strong>${labels[i]}</strong>
          </div>`;
      });
      pollHTML += `</div>`;

      showModalInfo("👥 Ý KIẾN KHÁN GIẢ", pollHTML);
      playTapSound();
    });

    document.getElementById("modalActionBtn").addEventListener("click", () => {
      resultModal.classList.remove("active");
      playTapSound();
    });

    function startLevelByName(levelName) {
      state.currentLevelName = levelName;
      state.currentLevelIndex = levelOrder.indexOf(levelName);
      state.usedQuestions = [];
      state.earned = 0;
      state.rounds = 0;
      state.answered = false;
      state.levelFinished = false;
      state.lifelines = { fiftyFifty: true, call: true, audience: true };
      clearTimer();

      resultModal.classList.remove("active");
      showScreen("gameScreen");
      ensureMusicGain();
      startMusicLoop();
      playStartSound();
      renderQuestion();
    }

    function goToNextLevel() {
      const nextIndex = state.currentLevelIndex + 1;
      const nextLevel = levelOrder[nextIndex] || levelOrder[0];
      startLevelByName(nextLevel);
    }

    function goHome() {
      stopMusicLoop();
      clearTimer();
      showScreen("homeScreen");
      playTapSound();
    }

    document.getElementById("playBtn").addEventListener("click", () => startLevelByName("siêu dễ"));
    document.getElementById("guideBtn").addEventListener("click", () => { showScreen("guideScreen"); playTapSound(); });
    document.getElementById("menuBtn").addEventListener("click", () => { showScreen("menuScreen"); playTapSound(); });
    document.getElementById("backFromGuide").addEventListener("click", () => { showScreen("homeScreen"); playTapSound(); });
    document.getElementById("backFromMenu").addEventListener("click", () => { showScreen("homeScreen"); playTapSound(); });

    document.querySelectorAll(".difficulty-btn").forEach(btn => {
      btn.addEventListener("click", () => startLevelByName(btn.dataset.level));
    });

    document.getElementById("nextBtn").addEventListener("click", () => {
      if (state.levelFinished) {
        resultModal.classList.remove("active");
        goToNextLevel();
      }
    });

    document.getElementById("homeBtnCenter").addEventListener("click", goHome);
    document.getElementById("homeBtnGame").addEventListener("click", goHome);

    document.getElementById("quitBtn").addEventListener("click", () => {
      clearTimer();
      showModalInfo("BẠN ĐÃ BỎ CUỘC", `<p>Bạn đã dừng cuộc chơi với số tiền thưởng: <strong>${formatMoney(state.earned)}</strong></p>`, true);
      playWrongSound();
      stopMusicLoop();
    });

    document.getElementById("restartBtn").addEventListener("click", () => {
      resultModal.classList.remove("active");
      startLevelByName(state.currentLevelName);
    });

    document.getElementById("homeBtnModal").addEventListener("click", () => {
      clearTimer();
      stopMusicLoop();
      resultModal.classList.remove("active");
      showScreen("homeScreen");
      playTapSound();
    });

    ensureMusicGain();
  </script>
</body>
</html>
