          { q: "Bảng chữ cái Tiếng Anh hiện đại có bao nhiêu chữ cái?", a: ["20", "24", "26", "28"], c: 2 },
          { q: "Nước nào được mệnh danh là 'Xứ sở sương mù'?", a: ["Pháp", "Anh", "Nhật Bản", "Mỹ"], c: 1 },
          { q: "Trong toán học, 2^5 có giá trị bằng:", a: ["10", "16", "32", "64"], c: 2 },
          { q: "Đại dương nào sâu nhất trên Trái Đất?", a: ["Thái Bình Dương", "Đại Tây Dương", "Ấn Độ Dương", "Bắc Băng Dương"], c: 0 }
