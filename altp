          { q: "Trong văn học, từ nào là từ láy?", a: ["Mẹ", "Lấp lánh", "Trẻ", "Học"], c: 1 },
          { q: "Số 9 là số nguyên tố hay hợp số?", a: ["Nguyên tố", "Hợp số", "Không phải cả hai", "Số chẵn"], c: 1 },
