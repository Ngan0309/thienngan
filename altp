        questions: [
          { q: "Tác phẩm 'Truyện Kiều' do ai sáng tác?", a: ["Nguyễn Trãi", "Nguyễn Du", "Ngoạn Lăng", "Hồ Xuân Hương"], c: 1 },
          { q: "Biểu thức nào là đơn thức?", a: ["x + 2", "3x", "x - y", "a + b"], c: 1 },
          { q: "Phương trình x + 5 = 9 có x bằng:", a: ["3", "4", "5", "6"], c: 1 },
          { q: "Đại dương lớn nhất thế giới là?", a: ["Đại Tây Dương", "Thái Bình Dương", "Ấn Độ Dương", "Bắc Băng Dương"], c: 1 },
          { q: "Nốt nhạc nào tương ứng với 'C' ở bàn phím piano?", a: ["Mi", "La", "Đô", "Pha"], c: 2 },
          { q: "Câu nào là câu nghi vấn?", a: ["Tôi rất vui.", "Bạn đã ăn chưa?", "Đừng đi ra ngoài.", "Hãy ngồi xuống."], c: 1 },
