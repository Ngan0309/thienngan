    <!-- GAME SCREEN -->
    <section id="gameScreen" class="screen">
      <div class="status-bar">
        <div id="levelInfo">Màn 1</div>
        <div id="moneyInfo">0đ</div>
      </div>

      <div class="game-layout">
        <div class="board">
          <!-- Lifelines UI -->
          <div class="lifelines">
            <button id="fiftyFiftyBtn" class="lifeline-btn">✂️ 50:50</button>
            <button id="callBtn" class="lifeline-btn">📞 Gọi điện</button>
            <button id="audienceBtn" class="lifeline-btn">👥 Khán giả</button>
          </div>

          <div id="questionBox" class="question-box">Câu hỏi sẽ hiển thị ở đây</div>
          <div id="answers" class="answers"></div>

          <div class="controls">
            <button id="quitBtn" class="secondary small-btn">Bỏ cuộc</button>
            <button id="homeBtnGame" class="ghost small-btn">Về trang chủ</button>
          </div>

          <div id="nextPanel" class="next-panel">
            <button id="nextBtn" class="primary">Sang màn tiếp theo</button>
            <button id="homeBtnCenter" class="secondary">Về lại trung tâm</button>
          </div>
        </div>

        <aside class="side-panel">
          <h3 style="margin:0; color:#ffd54a;">Mức thưởng</h3>
          <ul id="moneyList" class="money-list"></ul>
        </aside>
      </div>
    </section>
  </div>

  <!-- RESULT / HELP MODAL -->
  <div id="resultModal" class="modal">
    <div class="modal-card">
      <h2 id="resultTitle">Thông báo</h2>
      <div id="resultContent">
        <p id="resultText"></p>
